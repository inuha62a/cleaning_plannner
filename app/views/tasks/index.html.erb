<h2>登録済みタスク</h2>

<ul>
  <% @tasks.each do |task| %>
    <li>
      <strong><%= task.title %></strong><br>
      状態: <%= task.status %><br>
      次回予定: <%= task.calculate_next_due_date&.strftime("%Y/%m/%d") || "未定" %><br>
      <%= link_to "編集", edit_task_path(task) %> |
      <%= link_to "完了", mark_as_done_task_path(task), method: :patch %> |
      <%= link_to "削除", task_path(task), method: :delete, data: { confirm: "本当に削除しますか？" } %>
    </li>
  <% end %>
</ul>
