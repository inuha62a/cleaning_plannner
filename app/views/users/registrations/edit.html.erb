<h2>プロフィール編集</h2>

<div class="profile-box">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <label for="user_name" class="label">ユーザー名</label>
    <div class="input">
      <%= f.text_field :name, id: "user_name", placeholder: "表示される名前  ※ログインには使いません" %>
    </div>

    <label for="email" class="label">メールアドレス*</label>
    <div class="input">
      <%= f.text_field :email, id: "email", placeholder: "example@mail.com" %>
    </div>

    <label for="current_password" class="label">現在のパスワード（パスワード変更時のみ必須）</label>
    <div class="input">
      <%= f.password_field :current_password, id: "current_password", placeholder: "本人確認のため入力してください" %>
    </div>

    <label for="password" class="label">新しいパスワード*</label>
    <div class="input">
      <%= f.password_field :password, id: "password", placeholder: "英数字#{@minimum_password_length}文字以上" %>
    </div>

    <label for="password_confirmation" class="label">新しいパスワード(確認用)*</label>
    <div class="input">
      <%= f.password_field :password_confirmation, id: "password_confirmation", placeholder: "確認用パスワード" %>
    </div>

    <div class="form-checkbox form-checkbox--spaced">
      <label>
        <input type="checkbox" id="show-password-checkbox">
        パスワードを表示する
      </label>
    </div>

    <div class="actions">
      <%= f.submit "更新する", class: "button" %>
      <%= link_to "マイページへ戻る", users_profile_path, class: "button back-button" %>
    </div>
  <% end %>

  <h3 class="danger-title">アカウント削除</h3>
  <p class="note">アカウントを削除すると、すべてのデータが失われます。</p>

  <div class="danger-zone">
    <%= button_to "アカウントを削除する", registration_path(resource_name),
        method: :delete,
        class: "danger-button",
        data: {turbo_confirm: "本当に削除しますか？この操作は元に戻せません。"
      } %>

  </div>
  
</div>

<script src="/assets/show_password.js"></script>
