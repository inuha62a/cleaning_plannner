<h2>ログイン</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>
  <label for="email" class="label">メールアドレス*</label>
  <div class="input">
    <%= f.text_field :email, id: "email", placeholder: "example@mail.com" %>
  </div>

  <label for="password" class="label">パスワード*</label>
  <div class="input">
    <%= f.password_field :password, id: "password",  autocomplete: "current-password", placeholder: "パスワードを入力" %>
  </div>
  <div class="form-checkbox">
    <label>
      <input type="checkbox" id="show-password-checkbox">
      パスワードを表示する
    </label>
  </div>
  <div class="actions">
    <%= f.submit "ログイン" %>
  </div>
  <p class="wrapper">
    アカウントをお持ちでない方は
    <%= link_to "新規登録", new_registration_path(resource_name), class: "link-button signup-link-button" %>
  </p>
  <p class="wrapper">
    <%= link_to "トップに戻る", root_path, class: "back-link" %>
  </p>
<% end %>